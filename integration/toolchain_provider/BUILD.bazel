# An example of a module -- other than the root module and rules_vivado
# itself -- providing a Vivado toolchain. See MODULE.bazel for how it is
# registered.

load("@rules_vivado//build/vivado:rules.bzl", "VIVADO_TOOLCHAIN_TYPE", "vivado_toolchain")
load(":vivado_config_test.bzl", "vivado_config_test")

package(default_visibility = ["//visibility:public"])

vivado_toolchain(
    name = "provider_vivado",
    mode = "host",
    runner = "@rules_vivado//internal:host_run",
    # A deliberately distinctive path: actions resolved against this
    # toolchain reference Vivado under this prefix, which makes the
    # selection observable with `bazel aquery`.
    vivado_path = "/custom/provider/Vivado",
)

toolchain(
    name = "provider_vivado_toolchain",
    target_settings = ["@rules_vivado//:vivado_mode_custom"],
    toolchain = ":provider_vivado",
    toolchain_type = VIVADO_TOOLCHAIN_TYPE,
)

# A rule defined in this module, not in rules_vivado, that declares the
# Vivado toolchain and calls vivado_config(ctx). `bazel test //...` in the
# integration module runs it, through //:vivado_config_test there.
vivado_config_test(
    name = "vivado_config_test",
)
