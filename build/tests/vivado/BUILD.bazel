load(
    "//build/vivado:rules.bzl",
    "vivado_place_and_route",
    "vivado_program_flash",
    "vivado_project",
    "vivado_synthesis",
)
load(":hermetic_build_test.bzl", "hermetic_build_test")

# A trivial test project for vivado synthesis.
vivado_project(
    name = "blinky",
    srcs = ["blinky.sv"],
    defines = ["FPGA_XILINX=1"],
    part = "xc7a200tfbg484-2",
    top_level = "up_counter",
    xdcs = ["alinx-a200t-b.xdc"],
)

vivado_synthesis(
    name = "blinky_synth",
    project = ":blinky",
)

# Example: synthesize blinky with the hermetic (Bazel-installed) Vivado
# toolchain; the rule transitions to --//:vivado_mode=hermetic on its own.
# Tagged manual because a cold run downloads and installs Vivado (~100 GB,
# hours); with a warm install cache only the synthesis itself runs. Invoke
# explicitly:
#
#   bazel test //build/tests/vivado:blinky_synth_hermetic_test
#
# See "Hermetic mode" in README.md for how to configure the installation
# (the vivado.install tag in MODULE.bazel names the installer archive URL).
hermetic_build_test(
    name = "blinky_synth_hermetic_test",
    tags = ["manual"],
    targets = [":blinky_synth"],
)

vivado_place_and_route(
    name = "blinky_pnr",
    synthesis = ":blinky_synth",
)

# Program the bitstream permanently into the Alinx A200T's QSPI flash. The
# Micron MT25QL256 (256 Mbit = 32 MB) is the flash on the AX7A200 board.
#
#   bazel build //build/tests/vivado:blinky_flash       # builds blinky_flash.mcs
#   bazel run   //build/tests/vivado:blinky_flash -- \
#       --hostport localhost:3122 \
#       --device '*/xilinx_tcf/Digilent/<serial>'       # writes the flash
vivado_program_flash(
    name = "blinky_flash",
    size = 32,
    flash_part = "mt25ql256-spi-x1_x2_x4",
    interface = "SPIx4",
    deps = [":blinky_pnr"],
)
